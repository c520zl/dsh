{
  "meta": {
    "name": "Todo App Design Tokens",
    "version": "1.0.0",
    "date": "2026-11-01",
    "platforms": ["iOS", "Android", "Web (P2)"],
    "references": ["docs/ui-design.md"]
  },
  "color": {
    "light": {
      "background": "#F7F5F1",
      "surface": "#FFFFFF",
      "surfaceMuted": "#EFEBE4",
      "surfaceStrong": "#E4DED4",
      "textPrimary": "#201C18",
      "textSecondary": "#6D645B",
      "textTertiary": "#92887D",
      "border": "#E7E1D8",
      "borderStrong": "#D5CDC2",
      "accent": "#B94A2C",
      "accentPressed": "#A93E22",
      "accentSoft": "#F8E8E1",
      "onAccent": "#FFFFFF",
      "success": "#2F7D5C",
      "warning": "#A66A12",
      "danger": "#B42318",
      "info": "#2F5D8A",
      "focus": "#2F5D8A"
    },
    "dark": {
      "background": "#141210",
      "surface": "#1E1B18",
      "surfaceMuted": "#2A2622",
      "surfaceStrong": "#38322C",
      "textPrimary": "#F5F1EB",
      "textSecondary": "#B8AEA3",
      "textTertiary": "#8D8277",
      "border": "#332E29",
      "borderStrong": "#4A423A",
      "accent": "#F08A66",
      "accentPressed": "#FF9E7C",
      "accentSoft": "#3A241D",
      "onAccent": "#1B120E",
      "success": "#6DB99A",
      "warning": "#E5A54B",
      "danger": "#F27D72",
      "info": "#8BB8E0",
      "focus": "#8BB8E0"
    },
    "priority": {
      "none": { "light": "#92887D", "dark": "#8D8277" },
      "low": { "light": "#2F5D8A", "dark": "#8BB8E0" },
      "medium": { "light": "#A66A12", "dark": "#E5A54B" },
      "high": { "light": "#B94A2C", "dark": "#F08A66" }
    },
    "contrast": {
      "lightTextOnBackground": "15.54:1",
      "lightSecondaryOnBackground": "5.32:1",
      "lightOnAccent": "5.15:1",
      "darkTextOnBackground": "16.61:1",
      "darkSecondaryOnBackground": "8.56:1",
      "darkAccentOnBackground": "7.59:1"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Roboto', 'Noto Sans SC', 'PingFang SC', sans-serif",
      "mono": "ui-monospace, 'SF Mono', 'Roboto Mono', Menlo, monospace"
    },
    "scale": {
      "display": { "size": 32, "lineHeight": 38, "weight": 700, "letterSpacing": -0.4 },
      "title": { "size": 24, "lineHeight": 30, "weight": 700, "letterSpacing": -0.2 },
      "heading": { "size": 20, "lineHeight": 26, "weight": 600 },
      "bodyLarge": { "size": 17, "lineHeight": 26, "weight": 400 },
      "body": { "size": 16, "lineHeight": 24, "weight": 400 },
      "callout": { "size": 15, "lineHeight": 22, "weight": 400 },
      "label": { "size": 13, "lineHeight": 18, "weight": 500 },
      "caption": { "size": 12, "lineHeight": 16, "weight": 400 },
      "overline": { "size": 11, "lineHeight": 14, "weight": 600, "letterSpacing": 0.6 }
    }
  },
  "spacing": {
    "2xs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "4xl": 40,
    "5xl": 48,
    "6xl": 64
  },
  "radius": {
    "xs": 6,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 28,
    "full": 999
  },
  "shadow": {
    "level1": "0 1px 2px rgba(32, 28, 24, 0.06)",
    "level2": "0 4px 12px rgba(32, 28, 24, 0.10)",
    "level3": "0 12px 32px rgba(32, 28, 24, 0.16)",
    "darkLevel1": "0 1px 2px rgba(0, 0, 0, 0.40)",
    "darkLevel2": "0 8px 24px rgba(0, 0, 0, 0.50)"
  },
  "layout": {
    "designWidth": 390,
    "screenPadding": 20,
    "listGap": 8,
    "tabBarHeight": 64,
    "navigationBarHeight": 52,
    "fabSize": 56,
    "minTouchTarget": 44,
    "contentMaxWidth": 680
  },
  "motion": {
    "fast": 120,
    "standard": 200,
    "slow": 280,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reduceMotion": "respect system setting; replace transforms with opacity"
  },
  "icon": {
    "strokeWidth": 1.8,
    "sizes": { "sm": 16, "md": 20, "lg": 24, "xl": 32 }
  },
  "components": {
    "button": {
      "height": { "sm": 36, "md": 44, "lg": 52 },
      "radius": 12,
      "primary": { "bg": "accent", "fg": "onAccent" },
      "secondary": { "bg": "surfaceMuted", "fg": "textPrimary" },
      "pressedScale": 0.98
    },
    "taskCheckbox": { "size": 24, "hitArea": 44, "radius": "full" },
    "input": { "height": 44, "radius": 12, "bg": "surface", "border": "border" },
    "toast": { "radius": 12, "duration": 4000 }
  }
}
