# Spring Boot backend configuration (export these variables before running)
PORT=3000
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/todo_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DATABASE_USERNAME=todo
DATABASE_PASSWORD=todo

# Optional in development; required in production. Base64-encoded Ed25519 PKCS#8/SPKI PEM.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
JWT_ISSUER=todo-api
JWT_AUDIENCE=todo-app

GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

MAIL_DRIVER=log
MAIL_FROM=Todo App <no-reply@todo-app.test>
RESEND_API_KEY=

PUSH_ENABLED=false
PUSH_DRIVER=log

STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://127.0.0.1:3000
EXPORT_TTL_HOURS=24

RATE_LIMIT_PER_MINUTE=120
SYNC_RATE_LIMIT_PER_MINUTE=20
WORKER_ENABLED=true
