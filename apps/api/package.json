{
  "name": "@todo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Todo App backend API and worker",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "worker:dev": "nest start --watch --entryFile worker",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "db:migrate": "pnpm build && node dist/db/migrate.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.14",
    "luxon": "3.7.2",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "postgres": "4.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.21",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
