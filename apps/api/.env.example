# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL (PostgreSQL 18 in production; local tests may use 16)
DATABASE_URL=postgres://todo:todo@127.0.0.1:5432/todo_dev
DATABASE_POOL=10

# Redis (NOTIFY/login rate limits/idempotency)
REDIS_URL=redis://127.0.0.1:6379

# Ed25519 keys, base64-encoded PKCS#8/SPKI PEM. Optional in development only:
# the API generates an ephemeral key pair (tokens die on restart).
# Generate:
#   node -e "const {generateKeyPairSync}=require('node:crypto');const {privateKey,publicKey}=generateKeyPairSync('ed25519');console.log(Buffer.from(privateKey.export({format:'pem',type:'pkcs8'})).toString('base64'));console.log(Buffer.from(publicKey.export({format:'pem',type:'spki'})).toString('base64'))"
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
JWT_ISSUER=todo-api
JWT_AUDIENCE=todo-app
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
MAX_DEVICES=10

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_EMAIL_HOURLY_LIMIT=10
OTP_IP_HOURLY_LIMIT=30

# Apple / Google audiences (leave empty until the mobile app exists)
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Email: log (development only) or resend
MAIL_DRIVER=log
MAIL_FROM=Todo App <no-reply@todo-app.test>
RESEND_API_KEY=

# Push: log (no real push) or expo
PUSH_DRIVER=log
PUSH_ENABLED=false

# Exports
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://127.0.0.1:3000
EXPORT_TTL_HOURS=24

# Limits / retention
RATE_LIMIT_PER_MINUTE=120
SYNC_RATE_LIMIT_PER_MINUTE=20
TRASH_RETENTION_DAYS=30
CHANGE_LOG_RETENTION_DAYS=30
PROCESSED_OPS_RETENTION_DAYS=30
REMINDER_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=180

# Worker intervals
REMINDER_TICK_MS=5000
EXPORT_TICK_MS=5000
CLEANUP_TICK_MS=3600000

# Audit IP hashing
AUDIT_IP_SALT=change-me-in-production
